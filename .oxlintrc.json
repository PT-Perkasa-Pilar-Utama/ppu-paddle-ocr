{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // §1 — Do not suppress TypeScript errors with @ts-ignore (ban-ts-comment)
    // @ts-expect-error is allowed only when accompanied by a description explaining why.
    // @ts-ignore is banned entirely — it silences errors without a contract.
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false
      }
    ],

    // §2.2 — Do not use `any`. Use `unknown` and narrow the type.
    "typescript/no-explicit-any": "error",

    // §2.2 — Use explicit return types on all exported functions.
    "typescript/explicit-module-boundary-types": "error",

    // §2.2 — Prefer `type` over `interface` for data shapes.
    // Warn (not error) because `interface` is still valid for extensible contracts.
    "typescript/consistent-type-definitions": ["warn", "type"],

    // §2.2 — Separate `import type` from value imports. Two statements preferred.
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],

    // §2.2 — Enforce `import type` at statement level, not inline `{ type X }`.
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],

    // §2.2 (CLAUDE.md) — No `as` casts. Asserting to an unrelated type is banned.
    "typescript/no-unsafe-type-assertion": "error",

    // CLAUDE.md — No `!` non-null assertions. Handle null/undefined explicitly.
    "typescript/no-non-null-assertion": "error",

    // §2.2 — Catch variable must be typed as `unknown`, not `any`.
    "typescript/use-unknown-in-catch-callback-variable": "error",

    // §3.6 — Never use .then() chains. Always use async/await.
    "promise/prefer-await-to-then": "error",

    // §3.6 — Do not ignore promise rejections (no silent fire-and-forget).
    // Already covered by typescript/no-floating-promises (correctness), but
    // promise/valid-params and no-nesting add extra coverage.
    "promise/no-nesting": "error",

    // §4.4 / General — Avoid deeply nested ternaries. Extract to early returns.
    "no-nested-ternary": "error",

    // General — Variables that are never reassigned must be declared with const.
    "prefer-const": "error",

    // General — Use object shorthand ({ foo } not { foo: foo }).
    "object-shorthand": "error",

    // General — Use template literals over string concatenation.
    "prefer-template": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".opencode",
    ".claude",
    ".agents",
    "sandbox",
    "dist",
    "dist/*",
    "*.lock",
    "private-tests",
    "lib",
    "out"
  ]
}
